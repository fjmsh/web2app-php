# .github/workflows/build-apk.yml
name: Build APK

on:
  workflow_dispatch:
    inputs:
      apk_build_type:
        description: "Build Type"
        required: true
        default: "preview"
        type: choice
        options:
          - preview
          - debug

jobs:
  build:
    runs-on: ubuntu-26.04

    env:
      APP_NAME: ${{ github.event.repository.name }}
      BUILD_TYPE: ${{ github.event.inputs.apk_build_type }}
      RUN_NO: ${{ github.run_number }}

    steps:
      - name: Checkout
        uses: actions/checkout@v7

      - name: Setup JDK 17
        uses: actions/setup-java@v6
        with:
          distribution: 'temurin'
          java-version: '17'
          cache: 'gradle'

      - name: Setup Gradle
        uses: gradle/actions/setup-gradle@v6
      # with:
      #   gradle-version: '8.13'

      - name: Grant execute permission for gradlew
        run: chmod +x gradlew
        
      - name: Build with Gradle
        working-directory: ./
        run: ./gradlew assemble${BUILD_TYPE}

      - name: Rename APK
        run: |
          mv app/build/outputs/apk/${BUILD_TYPE}/app-${BUILD_TYPE}.apk \
             app/build/outputs/apk/${BUILD_TYPE}/${APP_NAME}-${RUN_NO}-${BUILD_TYPE}.apk

      - name: Upload APK
        uses: actions/upload-artifact@v7
        with:
          name: ${{ env.APP_NAME }}-${{ env.RUN_NO }}-${{ env.BUILD_TYPE }}.apk
          path: app/build/outputs/apk/${{ env.BUILD_TYPE }}/${{ env.APP_NAME }}-${{ env.RUN_NO }}-${{ env.BUILD_TYPE }}.apk
          retention-days: 30
          archive: false
